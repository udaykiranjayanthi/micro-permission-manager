{
  "name": "Micro Permission Manager",
  "description": "A simple extension that shows the permissions a website asks for and lets you manage them in granular detail.",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "./popup.html",
    "default_icon": "./static/assets/icon-16.png"
  },
  "icons": {
    "16": "./static/assets/icon-16.png",
    "32": "./static/assets/icon-32.png",
    "48": "./static/assets/icon-48.png",
    "128": "./static/assets/icon-128.png"
  },
  "permissions": ["scripting", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["./content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js", "static/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "./background.js"
  }
}
